generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum AssessmentType {
  CAT1
  CAT2
  ASSIGNMENT
  MIDTERM
  END_TERM
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  password     String
  firstName    String
  lastName     String
  role         Role      @default(TEACHER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  classStreams  ClassStream[]
  subjects      Subject[]
  assessments   Assessment[]

  @@index([email])
}

model ClassStream {
  id           String    @id @default(cuid())
  name         String    @unique
  academicYear String
  classTeacher User      @relation(fields: [teacherId], references: [id])
  teacherId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  students      Student[]
  classSubjects ClassSubject[]
  assessments   Assessment[]

  @@index([name])
}

model Student {
  id            String      @id @default(cuid())
  admissionNo   String      @unique
  firstName     String
  lastName      String
  gender        Gender
  dateOfBirth   DateTime
  parentName    String
  parentContact String
  email         String?
  address       String?
  photoUrl      String?
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  classStream   ClassStream @relation(fields: [streamId], references: [id])
  streamId      String
  scores        Score[]
  reportCards   ReportCard[]

  @@index([admissionNo])
  @@index([streamId])
}

model Subject {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  description String?
  status      SubjectStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  teacher       User?       @relation(fields: [teacherId], references: [id])
  teacherId     String?
  classSubjects ClassSubject[]
  assessments   Assessment[]

  @@index([code])
}

model ClassSubject {
  id        String      @id @default(cuid())
  stream    ClassStream @relation(fields: [streamId], references: [id])
  streamId  String
  subject   Subject     @relation(fields: [subjectId], references: [id])
  subjectId String
  createdAt DateTime    @default(now())

  @@unique([streamId, subjectId])
}

model Assessment {
  id          String          @id @default(cuid())
  name        String
  type        AssessmentType
  maxMarks    Float           @default(100)
  weight      Float           @default(1)
  term        String
  academicYear String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  subject     Subject         @relation(fields: [subjectId], references: [id])
  subjectId   String
  stream      ClassStream?    @relation(fields: [streamId], references: [id])
  streamId    String?
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdById String
  scores      Score[]

  @@index([subjectId])
  @@index([streamId])
}

// Connects ClassStream to Assessment — add after above
// Note: Add this after fixing circular reference
model Score {
  id           String     @id @default(cuid())
  marks        Float
  remarks      String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  student      Student    @relation(fields: [studentId], references: [id])
  studentId    String
  assessment   Assessment @relation(fields: [assessmentId], references: [id])
  assessmentId String

  @@unique([studentId, assessmentId])
  @@index([studentId])
  @@index([assessmentId])
}

model GradingScale {
  id       String @id @default(cuid())
  grade    String
  minScore Float
  maxScore Float
  points   Float
  remarks  String @default("")

  @@index([minScore])
}

model ReportCard {
  id            String   @id @default(cuid())
  term          String
  academicYear  String
  totalMarks    Float
  averageScore  Float
  grade         String
  position      Int
  totalStudents Int
  teacherRemarks  String?
  principalRemarks String?
  generatedAt   DateTime @default(now())

  student       Student  @relation(fields: [studentId], references: [id])
  studentId     String

  @@unique([studentId, term, academicYear])
  @@index([studentId])
}
